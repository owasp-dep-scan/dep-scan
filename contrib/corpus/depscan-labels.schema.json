{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owasp:depscan:schema:labels:1",
  "title": "dep-scan corpus labels",
  "description": "One item's labels: what a scan must find and what it must not. Every section names its source. A source of hand requires a citation for each expectation: a file:line reference for a used package or an expected finding, a sentence for an unused package or a forbidden one. oracle labels are derived from the callsites ground truth at package level; fixture labels are built into the fixture they describe.",
  "type": "object",
  "required": ["item"],
  "additionalProperties": false,
  "properties": {
    "item": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "reachability": {
      "$ref": "#/$defs/reachability"
    },
    "findings": {
      "$ref": "#/$defs/findings"
    },
    "joins": {
      "type": "object",
      "description": "Expected join records, one section per join of the vision's table this item carries. Each section names its source and has the shape its $defs entry describes; a hand section cites the source for every expectation.",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "advisory-usage-reach": {
          "$ref": "#/$defs/join-advisory-usage-reach"
        },
        "route-package": {
          "$ref": "#/$defs/join-route-package"
        },
        "lifecycle-phase": {
          "$ref": "#/$defs/join-lifecycle-phase"
        },
        "component-layer": {
          "$ref": "#/$defs/join-component-layer"
        },
        "component-runtime": {
          "$ref": "#/$defs/join-component-runtime"
        },
        "two-producers": {
          "$ref": "#/$defs/join-two-producers"
        },
        "two-manifests": {
          "$ref": "#/$defs/join-two-manifests"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "enum": ["oracle", "hand", "fixture"]
    },
    "reachability": {
      "type": "object",
      "required": ["source", "used"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "derivedFrom": {
          "type": "string",
          "description": "For oracle labels: how the labels were derived and from what."
        },
        "used": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usedPackage"
          }
        },
        "unused": {
          "type": "array",
          "description": "Declared packages the labels say are never used. Required for an oracle label; a hand label may omit it when the item names no unused package.",
          "items": {
            "$ref": "#/$defs/unusedPackage"
          }
        },
        "unmapped": {
          "type": "object",
          "description": "Truth package names the mapping could not turn into a purl, each with the number of certain uses behind it. The scorer counts every name as a used package no analyser matches, a recall miss reported apart as unmappedUsed.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "local": {
          "type": "object",
          "description": "Truth package names that are directories or modules of the project itself, each with its count of certain uses. They are no dependency, so no label and no miss.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "missingModules": {
          "type": "object",
          "description": "Truth package names that are modules the project imports but neither its tree nor any distribution holds, each with its count of certain uses and the reviewed reason. They are no dependency, so no label and no miss.",
          "additionalProperties": {
            "type": "object",
            "required": ["occurrences", "reason"],
            "additionalProperties": false,
            "properties": {
              "occurrences": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "required": ["used", "unused"],
          "additionalProperties": false,
          "properties": {
            "used": {
              "type": "integer",
              "minimum": 0
            },
            "unused": {
              "type": "integer",
              "minimum": 0
            },
            "unmapped": {
              "type": "integer",
              "minimum": 0
            },
            "local": {
              "type": "integer",
              "minimum": 0
            },
            "missingModule": {
              "type": "integer",
              "minimum": 0
            },
            "certainUses": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "properties": {
              "used": {
                "items": {
                  "required": ["purl", "citation"]
                }
              },
              "unused": {
                "items": {
                  "required": ["purl", "reason"]
                }
              }
            }
          }
        }
      ]
    },
    "usedPackage": {
      "type": "object",
      "required": ["purl"],
      "additionalProperties": false,
      "properties": {
        "purl": {
          "$ref": "#/$defs/purl"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1,
          "description": "Certain uses of the package in the project's own files, when the source counts them."
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "description": "A file:line reference for a hand label."
        }
      }
    },
    "unusedPackage": {
      "type": "object",
      "required": ["purl"],
      "additionalProperties": false,
      "properties": {
        "purl": {
          "$ref": "#/$defs/purl"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why the package is unused, for a hand label: a sentence over the project's own source."
        }
      }
    },
    "findings": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "purl", "rules"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "$ref": "#/$defs/category"
              },
              "purl": {
                "$ref": "#/$defs/purl"
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "citation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "reason"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "$ref": "#/$defs/category"
              },
              "purl": {
                "$ref": "#/$defs/purl",
                "description": "The negative control: no finding of this category on this purl. Omit to forbid the rules on every purl."
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Rule ids that must not fire. Omit to forbid every rule of the category."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Why the result is forbidden, for example a sentence over the control's source."
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "items": {
                  "required": ["category", "purl", "rules", "citation"]
                }
              }
            }
          }
        }
      ]
    },
    "purl": {
      "type": "string",
      "pattern": "^pkg:",
      "description": "A package URL with or without version; comparisons fold spelling through the same comparable_purl rule the product uses."
    },
    "category": {
      "enum": [
        "vulnerability",
        "malware",
        "memory-safety",
        "supply-chain",
        "binary-hardening",
        "mobile",
        "code",
        "license",
        "crypto",
        "health"
      ]
    },
    "join-advisory-usage-reach": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "description": "Scored from the item's reachability and findings labels; the section only switches the join on.",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "join-route-package": {
      "type": "object",
      "required": ["source", "routes"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "notes": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "method"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
              },
              "packages": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/purl"
                },
                "description": "Packages the route's handlers must use."
              },
              "controls": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/purl"
                },
                "description": "Packages the route's handlers must not be bound to."
              },
              "citation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "properties": {
              "routes": {
                "items": {
                  "required": ["citation"]
                }
              }
            }
          }
        }
      ]
    },
    "join-lifecycle-phase": {
      "type": "object",
      "required": ["source", "packages"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "notes": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["purl", "phase"],
            "additionalProperties": false,
            "properties": {
              "purl": {
                "$ref": "#/$defs/purl"
              },
              "phase": {
                "enum": ["shipped", "build-only", "dev-only"]
              },
              "citation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "properties": {
              "packages": {
                "items": {
                  "required": ["citation"]
                }
              }
            }
          }
        }
      ]
    },
    "join-component-layer": {
      "type": "object",
      "required": ["source", "packages"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "notes": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["purl", "layer"],
            "additionalProperties": false,
            "properties": {
              "purl": {
                "$ref": "#/$defs/purl"
              },
              "layer": {
                "enum": ["os", "application"]
              },
              "citation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "properties": {
              "packages": {
                "items": {
                  "required": ["citation"]
                }
              }
            }
          }
        }
      ]
    },
    "join-component-runtime": {
      "type": "object",
      "required": ["source", "packages"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "notes": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["purl"],
            "additionalProperties": false,
            "properties": {
              "purl": {
                "$ref": "#/$defs/purl"
              },
              "citation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "properties": {
              "packages": {
                "items": {
                  "required": ["citation"]
                }
              }
            }
          }
        }
      ]
    },
    "join-two-producers": {
      "type": "object",
      "required": ["source", "package"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "notes": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/purl"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "required": ["citation"]
          }
        }
      ]
    },
    "join-two-manifests": {
      "type": "object",
      "required": ["source", "package", "versions"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "notes": {
          "type": "string"
        },
        "package": {
          "$ref": "#/$defs/purl"
        },
        "versions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "citation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "hand"
              }
            }
          },
          "then": {
            "required": ["citation"]
          }
        }
      ]
    }
  }
}
